# ─── ML / Data ────────────────────────────────────────────────────────────────
# NOTE: Pre-trained model weights (models/*.h5, etc.) are intentionally tracked
# so that anyone cloning the repo can run inference without retraining.

# NOTE: data/raw/ and results/ are intentionally tracked
# so the project runs out of the box after cloning.

# Only ignore intermediate/generated data artifacts:
data/interim/
data/processed/

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
*.pem
*.key

# ─── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
frontend/build.log

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore override files with secrets
docker-compose.override.yml
docker-compose.local.yml

# ─── Results & Outputs ────────────────────────────────────────────────────────
# results/ is intentionally tracked (contains pre-computed metrics & figures).

